# Server-side only. These are NOT prefixed VITE_, which means Vite never inlines
# them into the browser bundle — they are read at request time inside api/.
# Copy to .env.local for `vercel dev`, and set the same values in Vercel.

# The passphrase you type to unlock the board. Make it long.
BOARD_PASSPHRASE=

# From the Upstash Redis integration. The Vercel marketplace has used both
# namings over time; api/board.ts accepts either pair.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
